# ================================================
# NEXUS — SPRINT 3 CONFIGURATION TEMPLATE
# ================================================

# --- LLM PROVIDER CONFIGURATION (Groq API Free Tier) ---
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_placeholder
LLM_CHEAP_MODEL=mixtral-8x7b-32768
LLM_REASONING_MODEL=llama-3.3-70b-versatile

# --- DATA ADAPTER CONFIGURATION (Portable) ---
DATA_ADAPTER=firestore
FIREBASE_PROJECT_ID=mindgigs-production-project-id
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# --- VECTOR STORE CONFIGURATION ---
VECTOR_STORE=faiss-cpu
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- FEATURE FLAGS & SECURITY ---
ENABLE_SEMANTIC_MATCH=true
ENABLE_CLARIFICATION=true
SECRET_KEY=nexus_mindgigs_super_secret_key_2026_change_in_prod
DATABASE_URL=sqlite+aiosqlite:///./nexus.db

# --- FRONTEND PUBLIC VARIABLES ---
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyPlaceholder
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mindgigs-production.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mindgigs-production
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mindgigs-production.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
